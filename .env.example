# ====================================================================
# Multi-Branch Restaurant AI Agent System - Environment Configuration
# ====================================================================

# Database: Strictly PostgreSQL (local Docker or free-tier cloud instance e.g. Neon, Supabase, Render)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/restaurant_ai

# ====================================================================
# LLM provider: "ollama" (local model) or "openai" (any OpenAI-compatible API)
# ====================================================================
LLM_PROVIDER=ollama

# --- Local Ollama (reached directly or via a free tunnel like ngrok/Cloudflare)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b

# --- OpenAI-compatible API (no local model needed)
# To use an API key instead of Ollama:
#   1. LLM_PROVIDER=openai
#   2. fill OPENAI_API_KEY and OPENAI_MODEL
#   3. point OPENAI_BASE_URL at your provider's /v1 root
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Provider presets:
#   DeepSeek     https://api.deepseek.com/v1                        deepseek-chat
#   Qwen/DashScope https://dashscope.aliyuncs.com/compatible-mode/v1 qwen-plus
#   Moonshot     https://api.moonshot.cn/v1                         moonshot-v1-8k
#   OpenRouter   https://openrouter.ai/api/v1                       deepseek/deepseek-chat
#   Groq         https://api.groq.com/openai/v1                     llama-3.3-70b-versatile

# Authentication / Security
JWT_SECRET=restaurant_ai_super_secret_jwt_key_change_in_production_32char_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
